<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#24223B">
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Haven Message" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:paddingBottom="6dp" />
 <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to refresh in app" android:textColor="#E5E2FA" android:textSize="11sp" />
 <TextView android:id="@+id/widget_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:minHeight="42dp" />
 <TextView android:id="@+id/widget_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:minHeight="42dp" />
 <TextView android:id="@+id/widget_row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:minHeight="42dp" />
 <TextView android:id="@+id/widget_row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:minHeight="42dp" />
</LinearLayout>
